# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# synced from materials/ at build time
/public/materials

# raw CAD exports: converted .glb models are committed in materials/*/_web/
*.stl
*.STL
*.step
*.STEP
*.stp
*.STP

# OS / editor
desktop.ini
Thumbs.db

# local Claude Code settings
.claude/settings.local.json
